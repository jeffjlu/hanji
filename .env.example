# --- Local Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=hanji
POSTGRES_PASSWORD=hanji_local_dev
POSTGRES_DB=hanji
POSTGRES_PORT=5432

# --- Application (read by packages/db and apps/api) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Must match the POSTGRES_* values above. URL-encode special characters in the password.
DATABASE_URL=postgres://hanji:hanji_local_dev@localhost:5432/hanji

NODE_ENV=development

# At least 32 characters. Generate a real one with: openssl rand -base64 48
SESSION_SECRET=change-me-local-dev-secret-at-least-32-chars

WEB_ORIGIN=http://localhost:5173
REGISTRATION_CODE=local-invite-code
PORT=3000
