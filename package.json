{
  "name": "hanji",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-Based Chinese & Japanese Learning App",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm -r --if-present run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "pnpm --filter @hanji/db run db:generate",
    "db:migrate": "pnpm --filter @hanji/db run db:migrate",
    "db:seed": "pnpm --filter @hanji/db run db:seed",
    "dev": "pnpm --filter @hanji/api run dev & pnpm --filter @hanji/web run dev",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    }
  }
}
